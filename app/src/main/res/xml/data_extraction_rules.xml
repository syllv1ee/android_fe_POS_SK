<?xml version="1.0" encoding="utf-8"?>
<!--
  Tidak ada data yang dicadangkan/dipindah (Android 12+). allowBackup="false" saja tidak menutup
  device-transfer. Isi app = token (TokenStore, plaintext), sesi, dan antrean sinkron di Room: refresh token
  dirotasi server sehingga salinan di HP lain pasti basi, dan antrean sinkron bisa terkirim dua kali.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
